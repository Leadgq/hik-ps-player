{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": false,
    "strictNullChecks": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmitOnError": true,
    "types": []
  }
}
