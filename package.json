{
  "name": "hik-ps-player",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "description": "海康 IMKH + MPEG-PS 按需播放。浏览器内拆包解码，支持预签名 URL 远端跳转。",
  "exports": {
    ".": "./dist/index.js",
    "./vue2": "./dist/vue2.js",
    "./vue3": "./dist/vue3.js",
    "./react": "./dist/react.js"
  },
  "scripts": {
    "dev": "pnpm --filter @hik-ps/playground dev",
    "dev:react": "pnpm --filter @hik-ps/playground-react dev",
    "build": "turbo run build && node scripts/collect-dist.mjs"
  },
  "files": [
    "dist",
    "assets",
    "README.md"
  ],
  "devDependencies": {
    "turbo": "^2.5.4"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "vue": "^2.6.14 || ^3.4.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
