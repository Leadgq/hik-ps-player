{
  "name": "hik-ps-player",
  "version": "0.1.3",
  "private": false,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "description": "海康 IMKH + MPEG-PS 按需播放。浏览器内拆包解码，支持预签名 URL 远端跳转。",
  "license": "MIT",
  "author": "Leadgq",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./vue2": {
      "types": "./dist/vue2.d.ts",
      "import": "./dist/vue2.js",
      "default": "./dist/vue2.js"
    },
    "./vue3": {
      "types": "./dist/vue3.d.ts",
      "import": "./dist/vue3.js",
      "default": "./dist/vue3.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @hik-ps/playground dev",
    "dev:react": "pnpm --filter @hik-ps/playground-react dev",
    "build": "turbo run build && node scripts/collect-dist.mjs",
    "prepublishOnly": "pnpm build"
  },
  "files": [
    "dist",
    "h265web",
    "LICENSE",
    "README.md"
  ],
  "devDependencies": {
    "turbo": "^2.5.4"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "vue": "^2.6.14 || ^3.4.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
